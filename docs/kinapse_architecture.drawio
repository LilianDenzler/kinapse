        <mxCell id="m_gen_b" value="generative conformer sampling&#10;&#10;• dig_runner — runall() DiG&#10;   sampler orchestration&#10;• experiment — top-level&#10;   experiment driver&#10;• postprocess — fold PDBs → xtc,&#10;   strip α/β linker&#10;&#10;[uses SO(3) tables in data/so3;&#10; external DiG model]" style="text;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontSize=10;" vertex="1" parent="m_gen">
