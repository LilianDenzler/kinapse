        <mxCell id="f_regions_b" value="• CDR_FR_RANGES — IMGT CDR1/2/3 + FR1–4 (A/B)&#10;• VARIABLE_RANGE = (1, 128)" style="text;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontSize=10;" vertex="1" parent="f_regions">
