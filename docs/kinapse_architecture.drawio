        <!-- CLI -->
        <mxCell id="cli" value="CLI   (kinapse …)" style="swimlane;rounded=1;html=1;startSize=30;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cli_b" value="• kinapse info    — version, config and data paths&#10;• kinapse prep    — load / IMGT-renumber / pair a TCR&#10;• kinapse geometry — α/β docking geometry&#10;• kinapse pipelines — list end-to-end workflows" style="text;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontSize=10;" vertex="1" parent="cli">
