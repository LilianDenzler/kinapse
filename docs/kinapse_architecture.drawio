          <mxGeometry x="40" y="266" width="500" height="18" as="geometry" />
        </mxCell>

        <!-- 1 structures -->
        <mxCell id="m_struct" value="1 · structures — the basis" style="swimlane;rounded=1;html=1;startSize=30;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="288" width="303" height="340" as="geometry" />
        </mxCell>
        <mxCell id="m_struct_b" value="load and prep TCR / TCR-pMHC&#10;&#10;• tcr.py — TCR, TCRPairView,&#10;   TrajectoryView, load_tcr&#10;• numbering/anarci_numbering —&#10;   ANARCII / legacy ANARCI (lazy)&#10;• numbering/tcr_pairing —&#10;   pair_tcrs_by_interface (Hungarian)&#10;• numbering/main —&#10;   apply_imgt_renumbering, process_pdb&#10;• io — load/write PDB, Bio↔biotite↔mdtraj&#10;• ops — copy_subset, sanitize_structure&#10;• select — region→atom predicates&#10;• linkers/ — link_alpha_beta (MODELLER)&#10;• pmhc — PMHC, TCRpMHC (scaffold)" style="text;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontSize=10;" vertex="1" parent="m_struct">
          <mxGeometry x="0" y="30" width="303" height="310" as="geometry" />
        </mxCell>

