          <mxGeometry x="359" y="288" width="303" height="340" as="geometry" />
        </mxCell>
        <mxCell id="m_embed_b" value="sequence embedders&#10;&#10;• fasta — pdb_to_fasta&#10;• msa — MMseqs2-GPU MSAs&#10;• evoformer — OpenFold /&#10;   Evoformer embeddings (torch)&#10;&#10;[optional 'embed' extra:&#10;   torch + OpenFold + MMseqs2]" style="text;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontSize=10;" vertex="1" parent="m_embed">
