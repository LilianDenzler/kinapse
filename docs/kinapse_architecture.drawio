        <!-- Title -->
        <mxCell id="title" value="kinapse — project organisation and features" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#141821;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1000" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Modular toolkit for TCR / TCR-pMHC structural dynamics · higher layers import lower · nothing below imports above" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5b6472;" vertex="1" parent="1">
