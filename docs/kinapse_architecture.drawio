          <mxGeometry x="420" y="100" width="1220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="pipe_b" value="• benchmark/  — run_calc_scaled, benchmarks_calc_scaled (+ _parallel), benchmark_table_maker,&#10;      compare_MD_adaptive_sampling, sample_MD_for_baselines, Standardise_by_RMSD, PyMOL viz, config_assess_modes*.yaml&#10;• best_method/ — asses_model_output, run_test, analyse_metrics, global_analysis_best_metric, global_method_selection, best_methods_config.yml&#10;• analyse_md/  — gt_flexibility_analysis (per-region RMSD-to-average, representative frame, ridgeline overlays)" style="text;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontSize=10;" vertex="1" parent="pipe">
          <mxGeometry x="0" y="30" width="1220" height="120" as="geometry" />
        </mxCell>

