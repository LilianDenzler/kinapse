        <mxCell id="f_config_b" value="• PathConfig · get_paths()&#10;• env vars (KINAPSE_*) / YAML — no hardcoded paths&#10;• package_data_dir(), so3_dir(), consensus_output_dir()" style="text;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;whiteSpace=wrap;fontSize=10;" vertex="1" parent="f_config">
