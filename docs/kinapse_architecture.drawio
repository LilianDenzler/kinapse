        <mxCell id="m_geom" value="3 · geometry" style="swimlane;rounded=1;html=1;startSize=30;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="678" y="288" width="303" height="340" as="geometry" />
        </mxCell>
        <mxCell id="m_geom_b" value="α/β inter-domain docking geometry&#10;&#10;• calc_geometry — 6-parameter&#10;   docking geometry (per structure)&#10;• calc_geometry_MD — per-frame&#10;   (streams via MDAnalysis)&#10;• change_geometry — rebuild a&#10;   structure from the 6 angles&#10;• get_anchor_coords — CDR anchor&#10;   CA coordinates&#10;• data/consensus_output —&#10;   reference structures + PCA axes" style="text;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontSize=10;" vertex="1" parent="m_geom">
          <mxGeometry x="0" y="30" width="303" height="310" as="geometry" />
        </mxCell>

        <!-- 4 analysis -->
        <mxCell id="m_anal" value="4 · analysis — structure + MD metrics" style="swimlane;rounded=1;html=1;startSize=30;fontStyle=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="997" y="288" width="303" height="340" as="geometry" />
        </mxCell>
        <mxCell id="m_anal_b" value="the scientific core&#10;&#10;• aligning — Kabsch / TMalign / ProFit&#10;• rmsd_tm — per-frame RMSD / TM-score&#10;• embeddings/features —&#10;   CA-dist · coords · dihedrals&#10;• embeddings/dim_reduction —&#10;   PCA · wPCA · kPCA · TICA · diffmap&#10;• embeddings/metrics —&#10;   trustworthiness · Mantel&#10;• embeddings/run_* — per-region runners&#10;• pmf_kde — PMF (hist+KDE) ·&#10;   Jensen–Shannon divergence&#10;• plotters — plot_pca / plot_pmf&#10;• PCA_methods, embed_assesment (legacy)" style="text;html=0;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;whiteSpace=wrap;fontSize=10;" vertex="1" parent="m_anal">
          <mxGeometry x="0" y="30" width="303" height="310" as="geometry" />
